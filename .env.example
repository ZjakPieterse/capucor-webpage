# Supabase — from your project dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SECRET — never expose in client code

# Domain seam — both optional; the defaults below ARE the production values.
# capucor.com serves the marketing site and the sales funnel through proposal
# signing; capucor.app is the legacy client portal, reached only through the
# old-path redirects and the Navbar link until os-sunset. Override only for a
# staging host. See "Domain seam" in AGENTS.md.
NEXT_PUBLIC_MARKETING_URL=          # default https://capucor.com
NEXT_PUBLIC_APP_URL=                # default https://capucor.app

# Cache revalidation — any long random string (openssl rand -hex 32)
REVALIDATE_SECRET=

# Transactional email (optional locally — without it, delivery reports pending
# and the link-bearing routes log their URL to Workers Logs; required in production)
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=           # e.g. zjak@capucor.com

# Booking/calendar URL (Navbar CTA, service pages, the above-R50m and Premium call prompts)
NEXT_PUBLIC_BOOKING_URL=            # e.g. https://calendar.app.google/ixopmxLuGgNH5Lkk8

# Signed-proposal PDF archival (PR10). When a proposal is signed, the site POSTs the
# rendered document to a Google Apps Script web app that files a PDF in the firm's
# Shared Drive. Both must be set or archival silently no-ops (signing still works).
# See scripts/apps-script/README.md for the deploy walkthrough.
APPS_SCRIPT_PDF_URL=                # the Apps Script web-app /exec URL
APPS_SCRIPT_PDF_SECRET=             # SECRET — must match the script's SHARED_SECRET
