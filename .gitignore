# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore real secrets, but keep the example template
.env*
!.env.example

# Wrangler local dev vars and private key material.
#
# ⚠️ ADDED 2026-09-04 AFTER A SECURITY REVIEW. The offline build's deny-filter
# kept these out of its disposable snapshot, and the byte-shared comment in
# scripts/build-cf-offline.mjs claimed .gitignore covered them — true in
# capucor-os, and not here. Nothing kept them out of a COMMIT.
.dev.vars*
*.key

# vercel
.vercel

# cloudflare / opennext
.open-next/

# typescript
*.tsbuildinfo
next-env.d.ts

# local Cloudflare/Wrangler state
.wrangler/

# Supabase CLI local state
supabase/.temp/
